# Atlas connection string, without a database name.
MONGODB_URI=
# Must start with "iceclub". The cluster holds other projects' databases.
DB_NAME=iceclub
PORT=4000
# 127.0.0.1 when nginx sits in front. Leave empty to listen on every address.
HOST=
NODE_ENV=production
# Only needed where Node cannot resolve Atlas SRV records.
DNS_SERVERS=
# Comma-separated admin panel URLs, or * for any. Mobile apps do not need CORS.
CORS_ORIGINS=https://your-admin-panel.vercel.app
# At least 32 random characters.
JWT_SECRET=
# Protects /api/cron/daily.
CRON_SECRET=
# Accepts the fixed OTP 123456 until an SMS provider is connected. Never true for real customers.
ALLOW_DEMO_OTP=false
# Treats online payments as paid until a payment gateway is connected. Never true for real customers.
ALLOW_DEMO_PAYMENTS=false
